// -------------------------------------------------------------
// ROBOT GEOMETRIC & PHYSICAL CONSTANTS
// -------------------------------------------------------------
//Note values of the wheels/chasis are all assumed for now
#define WHEEL_RADIUS_M 0.040f // Wheel radius (m) (assumed 80mm Mecanum)
#define CHASSIS_LX_M   0.120f // Distance from robot center to front/rear axles (m)
#define CHASSIS_LY_M   0.140f // Distance from robot center to left/right wheel contact lines (m)

// Motor: 102ZY24-250-A-01 (1:31 gearbox, 82 RPM loaded, 105 RPM no-load)
// 82 RPM ~ 8.59 rad/s, capped at 9.0 rad/s for velocity headroom normalization
#define MAX_WHEEL_RAD_S 9.0f

// Encoder: DFRobot SEN0230 (400 pulses/phase -> 1600 counts/rev in 4x quadrature)
#define ENCODER_PPR 1600.0f

#define CONTROL_LOOP_PERIOD_MS 19   // 100 Hz deterministic control loop rate
#define PIN_IBT2_ENABLE GPIO_NUM_27 // Shared enable for all IBT-2 drivers

// PWM configuration for IBT-2 (BTS7960) H-bridges
#define PWM_FREQ_HZ 2000 //20 kHZ ultrasonic switching
#define PWM_RES_BITS LEDC_TIMER_10_BIT
#define PWM_MAX_DUTY ((1 << 10) - 1) // value 1023

// Command link / Watchdog timeout
#define COMM_TIMEOUT_MS     300 // Failsafe triggers if no new packet arrives in 300ms
#define ESPNOW_WIFI_CHANNEL 1 // Must match transmitter channel exactly

// M.D enum format type
typedef enum{
  WHEEL_M1_FL = 0,
  WHEEL_M2_FR = 1,
  WHEEL_M3_BL = 2,
  WHEEL_M4_BR = 3,
  WHEEL_COUNT = 4
} wheel_id_t;

// r/l pwm and encoder struct format type
typedef struct{
  gpio_num_t r_pwm_pin;
  gpio_num_t l_pwm_pin;
  ledc_channel_t r_pwm_chan;
  ledc_channel_t l_pwm_chan;
  gpio_num_t enc_a_pin;
  gpio_num_t enc_b_pin;
  bool invert_motor;
  bool invert_encoder;
} motor_hw_config_t;

