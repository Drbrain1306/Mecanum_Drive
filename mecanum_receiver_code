// Struct typedef for chasis velocity
typedef struct{
  float vx; // Forward velocity (m/s)
  float vy; // Leftward velocity (m/s)
  float wz; // CCW angular velocity (rad/s)
} chassis_twist_t;

// Struct typedef for control and pid integral/error management 
typedef struct{
  float target_rad_s[WHEEL_COUNT];
  float meas_rad_s[WHEEL_COUNT];
  float pid_integral[WHEEL_COUNT];
  float pid_prev_error[WHEEL_COUNT]; // Range: [-1.0, 1.0]
  float control_effort[WHEEL_COUNT];
} drivetrain_state_t;

// Struct typedef for pid gains
typedef struct{
  float kp;
  float ki;
  float kd;
  float kff;
} pid_gains_t;

// Tuned feedforward and feedback gains for 250W 1:31 geared high-torque DC motors
// NOTE: Kd is kept at 0 to avoid derivative chatter from discrete pulse quantization
static const pid_gains_t PID_GAINS = {
  .kp = 0.120f, // current error, Kp ↑ → stronger response to speed error
  .ki = 0.025f, // Ki → reacts to accumulated error
  .kd = 0.000f, // kd → reacts to how quickly the error is changing
  .kff = 0.105f // Baseline voltage estimation ~ (1.0 / MAX_WHEEL_RAD_S)
};

// Pulse counter (pcnt)
static pcnt_unit_handle_t pcnt_units[WHEEL_COUNT];

// -----------------------------------------------------------------------------
// WIRE PROTOCOL (Exact 11-byte match to Transmitter robot_cmd_t)
// -----------------------------------------------------------------------------
typedef struct __attribute__((packed)){
  int16_t x_norm; // Strafe axis (-1000 to +1000)
  int16_t y_norm; // Forward axis (-1000 to +1000)
  int16_t yaw_norm; // Rotation axis (-1000 to +1000)
  uint8_t estop; // 1 = Emergency Stop, 0 = Normal
  uint32_t seq; // Monotonically increasing packet counter
} robot_cmd_t;

static QueueHandle_t s_cmd_queue = NULL;

// Receive Call back function 
static void espnow_recv_cb(const esp_now_recv_info_t *recv_info, const uint8_t *data, int len){
  if (len != sizeof(robot_cmd_t)){
    ESP_LOGW(TAG, "Dropped packet: bad size %d (expected %d)", len, (int)sizeof(robot_cmd_t));
    return;
  }

  robot_cmd_t cmd;
  memcpy(&cmd, data, sizeof(cmd));
  xQueueOverwrite(s_cmd_queue, &cmd);
}

// Initialize espnow communi btw commander and receiver
static void init_espnow(void){
  esp_err_t ret = nvs_flash_init();
  if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND){
    ESP_ERROR_CHECK(nvs_flash_erase());
    ret = nvs_flash_init();
  }
  ESP_ERROR_CHECK(ret);

  ESP_ERROR_CHECK(esp_netif_init());
  ESP_ERROR_CHECK(esp_event_loop_create_default());

  wifi_init_config_t wifi_cfg = WIFI_INIT_CONFIG_DEFAULT();
  ESP_ERROR_CHECK(esp_wifi_init(&wifi_cfg));
  ESP_ERROR_CHECK(esp_wifi_set_storage(WIFI_STORAGE_RAM));
  ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
  ESP_ERROR_CHECK(esp_wifi_start());
  ESP_ERROR_CHECK(esp_wifi_set_ps(WIFI_PS_NONE)); // Disable power saving for consistent latency
  ESP_ERROR_CHECK(esp_wifi_set_channel(ESPNOW_WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE));

  s_cmd_queue = xQueueCreate(1, sizeof(robot_cmd_t));
  if(s_cmd_queue == NULL){
    ESP_LOGE(TAG, "Failed to create ESP-NOW queue");
  }

  ESP_ERROR_CHECK(esp_now_init());
  ESP_ERROR_CHECK(esp_now_register_recv_cb(espnow_recv_cb));

  ESP_LOGI(TAG, "ESP-NOW receiver active on Wi-Fi channel %d", ESPNOW_WIFI_CHANNEL);
}

// -----------------------------------------------------------------------------
// HARDWARE INITIALIZATION
// -----------------------------------------------------------------------------
static void init_ibt2_pwm_and_enables(void){
  ledc_timer_config_t time_conf = {
    .speed_mode = LEDC_LOW_SPEED_MODE,
    .duty_resolution = PWM_RES_BITS,
    .timer_num = LEDC_TIMER_0,
    .freq_hz = PWM_FREQ_HZ,
    .clk_cfg = LEDC_AUTO_CLK
  };
  ESP_ERROR_CHECK(ledc_timer_config(&time_conf)); // Checks for error in set timer configs

  for(int i = 0; i < WHEEL_COUNT; i++){
    // Configure R_PWM LEDC channel
    ledc_channel_config_t chan_r = {
      .gpio_num = HW_CONFIG[i].r_pwm_pin,
      .speed_mode = LEDC_LOW_SPEED_MODE,
      .channel = HW_CONFIG[i].r_pwm_chan,
      .intr_type = LEDC_INTR_DISABLE,
      .timer_sel = LEDC_TIMER_0,
      .duty = 0,
      .hpoint = 0
    };
    ESP_ERROR_CHECK(ledc_channel_config(&chan_r)); // Checks for error in channel settings of chan_r config

    // Configure L_PWM LEDC channel
    ledc_channel_config_t chan_l = {
      .gpio_num = HW_CONFIG[i].l_pwm_pin,
      .speed_mode = LEDC_LOW_SPEED_MODE,
      .channel = HW_CONFIG[i].l_pwm_chan,
      .intr_type = LEDC_INTR_DISABLE,
      .timer_sel = LEDC_TIMER_0,
      .duty = 0,
      .hpoint = 0
    };
    ESP_ERROR_CHECK(ledc_channel_config(&chan_l)); // Checks for error in channel settings of chan_l config
  }

  // Configure IBT-2 Enable Pin (GPIO 27)
  gpio_config_t en_conf = {
    .pin_bit_mask = (1ULL << PIN_IBT2_ENABLE),
    .mode = GPIO_MODE_OUTPUT,
    .pull_up_en = GPIO_PULLUP_DISABLE,
    .pull_down_en = GPIO_PULLDOWN_DISABLE,
    .intr_type = GPIO_INTR_DISABLE
  };
  ESP_ERROR_CHECK(gpio_config(&en_conf));
  gpio_set_level(PIN_IBT2_ENABLE, 1); // Enable BTS7960 bridges
}

static void init_pcnt_encoders(void) {
  pcnt_unit_config_t unit_config = {
    .low_limit = -32768,
    .high_limit = 32767
  };
    for(int i = 0; i < WHEEL_COUNT; i++){
    ESP_ERROR_CHECK(pcnt_new_unit(&unit_config, &pcnt_units[i]));

    // Glitch filter: suppresses spikes shorter than 1000 ns
    pcnt_glitch_filter_config_t filter_config = {
      .max_glitch_ns = 1000,
    };
    ESP_ERROR_CHECK(pcnt_unit_set_glitch_filter(pcnt_units[i], &filter_config));

    // 4x Quadrature Decoding: Phase A edge, Phase B level
    pcnt_chan_config_t chan_a_config = {
      .edge_gpio_num = HW_CONFIG[i].enc_a_pin,
      .level_gpio_num= HW_CONFIG[i].enc_b_pin
    };
    pcnt_channel_handle_t chan_a = NULL;
    ESP_ERROR_CHECK(pcnt_new_channel(pcnt_units[i], &chan_a_config, &chan_a));
    ESP_ERROR_CHECK(pcnt_channel_set_edge_action(chan_a, PCNT_CHANNEL_EDGE_ACTION_DECREASE, PCNT_CHANNEL_EDGE_ACTION_INCREASE));
    ESP_ERROR_CHECK(pcnt_channel_set_level_action(chan_a, PCNT_CHANNEL_LEVEL_ACTION_KEEP, PCNT_CHANNEL_LEVEL_ACTION_INVERSE));

    // 4x Quadrature Decoding: Phase B edge, Phase A level
    pcnt_chan_config_t chan_b_config = {
        .edge_gpio_num  = HW_CONFIG[i].enc_b_pin,
        .level_gpio_num = HW_CONFIG[i].enc_a_pin,
    };
    pcnt_channel_handle_t chan_b = NULL;
    ESP_ERROR_CHECK(pcnt_new_channel(pcnt_units[i], &chan_b_config, &chan_b));
    ESP_ERROR_CHECK(pcnt_channel_set_edge_action(chan_b, PCNT_CHANNEL_EDGE_ACTION_INCREASE, PCNT_CHANNEL_EDGE_ACTION_DECREASE));
    ESP_ERROR_CHECK(pcnt_channel_set_level_action(chan_b, PCNT_CHANNEL_LEVEL_ACTION_KEEP, PCNT_CHANNEL_LEVEL_ACTION_INVERSE));

    ESP_ERROR_CHECK(pcnt_unit_enable(pcnt_units[i]));
    ESP_ERROR_CHECK(pcnt_unit_clear_count(pcnt_units[i]));
    ESP_ERROR_CHECK(pcnt_unit_start(pcnt_units[i]));
  }
}

// -----------------------------------------------------------------------------
// CONTROL PIPELINE
// -----------------------------------------------------------------------------
static chassis_twist_t condition_inputs(float raw_x, float raw_y, float raw_yaw){
  chassis_twist_t cmd;
  const float deadband = 0.05f; //ignore very small joystick/controller inputs

  float x   = (fabsf(raw_x)   < deadband) ? 0.0f : raw_x;
  float y   = (fabsf(raw_y)   < deadband) ? 0.0f : raw_y;
  float yaw = (fabsf(raw_yaw) < deadband) ? 0.0f : raw_yaw;

  //These define how aggressively the robot responds to the controller
  // Map normalized inputs [-1.0, 1.0] to physical robot velocities
  // Forward / Backward along X-axis
  cmd.vx = y * 0.32f;
  // Strafe Left / Right along Y-axis (Inverted to follow standard ROS REP-103 frame)
  cmd.vy = -x * 0.32f;
  // Angular rotation rate (rad/s)
  cmd.wz = -yaw * 1.20f;

  return cmd;
}

// Computing the standard Mecanum Inverse Kinematics
static void compute_inverse_kinematics(const chassis_twist_t *cmd, float out_targets[WHEEL_COUNT]) {
  const float k_geom = CHASSIS_LX_M + CHASSIS_LY_M;
  const float inv_r  = 1.0f / WHEEL_RADIUS_M;

  // Standard Mecanum Inverse Kinematics (O-shape roller footprint)
  out_targets[WHEEL_M1_FL] = inv_r * (cmd->vx - cmd->vy - (k_geom * cmd->wz));
  out_targets[WHEEL_M2_FR] = inv_r * (cmd->vx + cmd->vy + (k_geom * cmd->wz));
  out_targets[WHEEL_M3_BL] = inv_r * (cmd->vx + cmd->vy - (k_geom * cmd->wz));
  out_targets[WHEEL_M4_BR] = inv_r * (cmd->vx - cmd->vy + (k_geom * cmd->wz));

  // Vector headroom scaling: Preserves directional trajectory when any motor saturates
  float max_speed = 0.0f;
  for (int i = 0; i < WHEEL_COUNT; i++) {
    float spd = fabsf(out_targets[i]);
    if (spd > max_speed) {
        max_speed = spd;
    }  
  }

  if(max_speed > MAX_WHEEL_RAD_S) {
    float scalar = MAX_WHEEL_RAD_S / max_speed;
    for(int i = 0;  i < WHEEL_COUNT; i++){
      out_targets[i] *= scalar;
    }
  }
}

static void sample_encoder_feedback(drivetrain_state_t *state, float dt) {
  for (int i = 0; i < WHEEL_COUNT; i++) {
    int pulse_count = 0;
    pcnt_unit_get_count(pcnt_units[i], &pulse_count);
    pcnt_unit_clear_count(pcnt_units[i]);

    if (HW_CONFIG[i].invert_encoder) {
        pulse_count = -pulse_count;
    }

    float revs = (float)pulse_count / ENCODER_PPR;
    state->meas_rad_s[i] = (revs * 2.0f * (float)M_PI) / dt;
  }
}

static void compute_wheel_pid(drivetrain_state_t *state, float dt) {
  for (int i = 0; i < WHEEL_COUNT; i++) {
    float error = state->target_rad_s[i] - state->meas_rad_s[i];

      // Anti-windup integration clamp
    state->pid_integral[i] += error * dt;
    if (state->pid_integral[i] > 10.0f)  state->pid_integral[i] = 10.0f;
    if (state->pid_integral[i] < -10.0f) state->pid_integral[i] = -10.0f;

    float effort = (PID_GAINS.kff * state->target_rad_s[i]) +
                   (PID_GAINS.kp  * error) +
                   (PID_GAINS.ki  * state->pid_integral[i]);

    // Output clamping to normalized range [-1.0, 1.0]
    if (effort > 1.0f)  effort = 1.0f;
    if (effort < -1.0f) effort = -1.0f;

    state->control_effort[i] = effort;
  }
}

static void apply_actuation_ibt2(const drivetrain_state_t *state) {
  for (int i = 0; i < WHEEL_COUNT; i++) {
    float effort = state->control_effort[i];

    if (HW_CONFIG[i].invert_motor) {
        effort = -effort;
    }

    uint32_t duty = (uint32_t)(fabsf(effort) * (float)PWM_MAX_DUTY);

    if (effort > 0.01f) {
        // Forward: drive R_PWM, silence L_PWM
        ledc_set_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].r_pwm_chan, duty);
        ledc_set_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].l_pwm_chan, 0);
    } else if (effort < -0.01f) {
        // Reverse: drive L_PWM, silence R_PWM
        ledc_set_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].r_pwm_chan, 0);
        ledc_set_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].l_pwm_chan, duty);
    } else {
        // Active electrical braking (both low side engaged)
        ledc_set_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].r_pwm_chan, 0);
        ledc_set_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].l_pwm_chan, 0);
    }

    ledc_update_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].r_pwm_chan);
    ledc_update_duty(LEDC_LOW_SPEED_MODE, HW_CONFIG[i].l_pwm_chan);
  }
}

// -----------------------------------------------------------------------------
// DETERMINISTIC 100 HZ CONTROL TASK
// -----------------------------------------------------------------------------
static void mecanum_control_task(void *pvParameters) {
  TickType_t last_wake_time = xTaskGetTickCount();
  const TickType_t period_ticks = pdMS_TO_TICKS(CONTROL_LOOP_PERIOD_MS);
  const float dt = (float)CONTROL_LOOP_PERIOD_MS / 1000.0f;

  drivetrain_state_t drive_state = {0};
  robot_cmd_t local_cmd = {0};
  uint32_t last_seen_seq = 0;
  TickType_t last_rx_tick = xTaskGetTickCount();
  bool packet_ever_received = false;

  ESP_LOGI(TAG, "Mecanum 100 Hz closed-loop control running");

  for (;;) {
    // Read latest command from ESP-NOW receiver callback
    if (xQueueReceive(s_cmd_queue, &local_cmd, 0) == pdTRUE) {
      packet_ever_received = true;
      if (local_cmd.seq != last_seen_seq) {
        last_seen_seq = local_cmd.seq;
        last_rx_tick = xTaskGetTickCount();
      }
    }

    // Failsafe & Staleness Watchdog
    TickType_t elapsed_ticks = xTaskGetTickCount() - last_rx_tick;
    bool comm_stale = (!packet_ever_received) || (elapsed_ticks > pdMS_TO_TICKS(COMM_TIMEOUT_MS));
    bool failsafe_active = comm_stale || (local_cmd.estop != 0);

    float joy_x = 0.0f, joy_y = 0.0f, joy_yaw = 0.0f;

    if (failsafe_active) {

      // Immediate integral flush to prevent torque jerking when link reconnects
      for (int i = 0; i < WHEEL_COUNT; i++) {
        drive_state.pid_integral[i] = 0.0f;
      }
    } else {
        joy_x   = (float)local_cmd.x_norm   / 1000.0f;
        joy_y   = (float)local_cmd.y_norm   / 1000.0f;
        joy_yaw = (float)local_cmd.yaw_norm / 1000.0f;
      }

    chassis_twist_t cmd = condition_inputs(joy_x, joy_y, joy_yaw);

    compute_inverse_kinematics(&cmd, drive_state.target_rad_s);
    sample_encoder_feedback(&drive_state, dt);
    compute_wheel_pid(&drive_state, dt);
    apply_actuation_ibt2(&drive_state);

    vTaskDelayUntil(&last_wake_time, period_ticks);
    }
}

void setup(void) {
  ESP_LOGI(TAG, "Initializing Mecanum Controller System...");

  init_espnow();
  init_ibt2_pwm_and_enables();
  init_pcnt_encoders();

  // Pin high-priority control task to Core 1 (leaving Core 0 for Wi-Fi / ESP-NOW stacks)
  xTaskCreatePinnedToCore(
    mecanum_control_task,
    "mecanum_ctrl",
    4096,
    NULL,
    configMAX_PRIORITIES - 2,
    NULL,
    1
  );
}

